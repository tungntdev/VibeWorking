{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Office 3D",
  "version": "1.0.0",
  "identifier": "vn.vibeworking.aioffice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Office 3D — Văn phòng AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://tauri.localhost ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: tauri: http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost tauri: http://tauri.localhost data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Văn phòng AI 3D",
    "longDescription": "Văn phòng 3D với các nhân viên AI kết nối Claude, Codex, Gemini, Ollama...",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQ0E3MkI1RUZBQ0IxNTcKUldSWHNhenZ0WExLajI3QjI2ZDVXa2tzOXVITktITnQ2USt0TmZjYmJ5cXF0eTZBSXVVNy8rTnQK",
      "endpoints": [
        "https://github.com/tungntdev/VibeWorking/releases/latest/download/latest.json"
      ]
    }
  }
}
